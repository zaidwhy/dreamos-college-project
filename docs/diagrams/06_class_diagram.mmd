classDiagram
    class SearchHit {
      +str path
      +str name
      +str category
      +str summary
      +str snippet
      +float similarity
      +str abs_path
    }
    class NLResponse {
      +str intent
      +str message
      +List~SearchHit~ search_results
      +List~dict~ organize_suggestions
      +str open_path
      +List~dict~ related
      +List~dict~ recommendations
      +List~dict~ workspaces
      +List~str~ open_paths
    }
    class OrganizeSuggestion {
      +str path
      +str summary
      +List~str~ tags
      +str category
      +str reasoning
    }
    class RelatedFile {
      +str path
      +List~str~ kinds
      +float weight
    }
    class Recommendation {
      +str kind
      +str title
      +str detail
      +List~str~ paths
      +str action
      +str workspace_name
    }
    class Turn {
      +str role
      +str message
      +str intent
      +List~str~ paths
    }
    class Settings {
      +Path vault_dir
      +float search_similarity_threshold
      +float graph_similarity_threshold
      +float graph_cluster_min_link
      +float open_ambiguity_margin
      +int frequent_open_threshold
    }
    class OllamaClient {
      +embed(text) List~float~
      +generate_json(prompt) dict
    }

    NLResponse "1" --> "*" SearchHit : search_results
    NLResponse "1" --> "*" OrganizeSuggestion : organize_suggestions
    NLResponse "1" --> "*" RelatedFile : related
    NLResponse "1" --> "*" Recommendation : recommendations
    NLResponse ..> OllamaClient : classifies via
    NLResponse ..> Turn : saved as
    SearchHit ..> Settings : reads
    Recommendation ..> Settings : thresholds
